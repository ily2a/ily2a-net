# Node 25+ ships an experimental global localStorage. The `debug` package bundled by
# Sanity's client touches it during server rendering, so Node 26 prints an
# ExperimentalWarning on every build. Server code never needs Web Storage, so turn it
# off for all npm scripts (same behaviour as Node 24).
#
# npm REPLACES NODE_OPTIONS with this value, so a NODE_OPTIONS set in the shell or
# the Vercel dashboard is ignored by npm scripts. Add other Node flags here,
# space-separated (e.g. `--no-experimental-webstorage --max-old-space-size=4096`).
node-options=--no-experimental-webstorage
